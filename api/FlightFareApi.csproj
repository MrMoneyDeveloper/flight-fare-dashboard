<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- ──────────────────────────────────────────────── -->
  <!--  Project-wide settings                          -->
  <!-- ──────────────────────────────────────────────── -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Optional niceties -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>preview</LangVersion>      <!-- allow C#13 previews, if desired -->
  </PropertyGroup>

  <!-- ──────────────────────────────────────────────── -->
  <!--  NuGet dependencies                             -->
  <!--  (pin to latest stable at the time of writing)  -->
  <!-- ──────────────────────────────────────────────── -->
  <ItemGroup>
    <PackageReference Include="Dapper"                       Version="2.2.0"   />
    <PackageReference Include="DuckDB.NET.Data"              Version="1.3.5"   />
    <PackageReference Include="Microsoft.AspNetCore.SignalR" Version="7.0.16"  />
    <PackageReference Include="Swashbuckle.AspNetCore"       Version="6.6.7"   />

    <!-- JSON serialisation helpers (optional but common) -->
    <PackageReference Include="System.Text.Json"             Version="8.0.5"   />
  </ItemGroup>

</Project>
